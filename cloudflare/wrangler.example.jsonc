{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "otello-tracker",
  "main": "src/worker.py",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["python_workers", "python_workflows"],
  "ai": { "binding": "AI" },

  "workflows": [
    {
      "name": "otello-full-refresh",
      "binding": "FULL_REFRESH",
      "class_name": "FullRefreshWorkflow"
    },
    {
      "name": "otello-r2-snapshot-drill",
      "binding": "R2_SNAPSHOT_DRILL",
      "class_name": "R2SnapshotDrillWorkflow"
    }
  ],

  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "otello-nav",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "SOURCE_ARCHIVE",
      "bucket_name": "otello-source-archive"
    }
  ],

  "triggers": {
    "crons": ["*/30 * * * *", "35 3 * * *", "37-43 14,15 * * 1-5", "17-23 11,12 * * 1-5"]
  },

  "observability": {
    "enabled": true
  }
}
