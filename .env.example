APP_ENV=development
APP_NAME=Otello NAV Dashboard
WEB_BIND=127.0.0.1
WEB_PORT=3000
DATA_DIR=./data
DATABASE_PATH=/data/otello.db
CORS_ORIGINS=http://localhost:3000
TZ=Europe/Oslo

# Lett intradag-refresh. Minimum 5 minutter; 30 minutter er standard.
REFRESH_INTERVAL_MINUTES=30
REFRESH_RUN_ON_START=true

# Tunge kilder/full historisk rebuild og verifisert SQLite-backup kjøres daglig.
FULL_REFRESH_INTERVAL_MINUTES=1440
BACKUP_INTERVAL_MINUTES=1440
BACKUP_DIR=/data/backups

# Senere datakilder - legg ekte nøkler kun i lokal/managed secret store.
BRAPI_TOKEN=
EODHD_API_KEY=
