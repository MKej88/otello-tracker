# Cloud production template. Copy to .env on the cloud host and keep real values out of Git.
APP_ENV=production
APP_NAME=Otello NAV Dashboard

# The web container is the only service that should be reachable from the cloud edge.
# Use 0.0.0.0 when the cloud load balancer/reverse proxy connects to the host port.
WEB_BIND=0.0.0.0
WEB_PORT=3000

# Must point to durable/persistent cloud storage, never ephemeral container storage.
DATA_DIR=/var/lib/otello
DATABASE_PATH=/data/otello.db
BACKUP_DIR=/data/backups

# Replace with the final HTTPS dashboard origin.
CORS_ORIGINS=https://dashboard.example.com
TZ=Europe/Oslo

REFRESH_INTERVAL_MINUTES=30
REFRESH_RUN_ON_START=true
FULL_REFRESH_INTERVAL_MINUTES=1440
BACKUP_INTERVAL_MINUTES=1440

# Put real secrets in the provider's secret manager or the host .env, never in Git.
BRAPI_TOKEN=
EODHD_API_KEY=
